# ---------------------------------------------------------------------------
# Data. Nothing under data/ is committed except the .gitkeep placeholders and
# the small derived tables in data/processed that the dashboard reads.
#
# data/restricted/ is excluded as a whole directory rather than by pattern, so
# a newly added file cannot slip into a commit merely because no rule matched
# it. Anything whose licence does not permit redistribution goes there.
# ---------------------------------------------------------------------------
data/raw/*
data/interim/*
data/restricted/
!data/raw/.gitkeep
!data/interim/.gitkeep

# Derived outputs are publishable, but the large intermediates are not.
data/processed/*.tsv
data/processed/*.csv
!data/processed/.gitkeep

# The variant map is derived (from Bryois snp_pos.txt.gz) but is 5.35M rows and
# ~111 MB, over GitHub's 100 MB file limit. It is a lookup table, not a result,
# and `python -m pipeline.s12_smr_exposures` rebuilds it in seconds -- so it is
# excluded on size grounds rather than licence ones. Any other derived table
# that grows past ~50 MB should be treated the same way.
data/processed/variant_map.parquet

# Logs are excluded, with deliberate exceptions. downloads.json (which bytes
# each run read), decisions.jsonl (which methodological choices were made and
# when) and the per-stage sNN_* gene-loss records are not scratch output --
# they are the reproducibility record, and the dashboard's methodology tab
# reads them. A clone without them cannot reproduce or audit the result.
logs/*
!logs/.gitkeep
!logs/downloads.json
!logs/decisions.jsonl
!logs/s[0-9][0-9]_*.json
!logs/s[0-9][0-9]_*.csv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit secrets must never be committed.
.streamlit/secrets.toml
